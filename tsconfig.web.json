{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "preserve", "jsxImportSource": "solid-js", "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/api.d.ts"]
}
