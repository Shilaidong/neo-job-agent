{
  "name": "neo-job-agent",
  "productName": "Terra-Edu Neo Job Agent",
  "version": "0.1.0",
  "private": true,
  "description": "求职投递工作台：左边是求职/招聘网页，右边是和 AI 的对话。AI 读学生材料、定位求职目标、生成并修改 LaTeX 简历导出 PDF、每天定时抓取岗位、一键投递全自动填表。原版 OpenCode CLI + 自研内嵌浏览器工具。",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test src",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:tasks": "electron-vite build && electron . --smoke-tasks",
    "smoke:feed": "electron-vite build && electron . --smoke-feed",
    "smoke:resume": "electron-vite build && electron . --smoke-resume",
    "smoke:materials": "electron-vite build && electron . --smoke-materials",
    "build:native": "./scripts/build-native.sh",
    "build:ocr": "bun scripts/build-paddleocr.ts",
    "fetch:ego": "bun scripts/fetch-ego.ts",
    "smoke:e2e": "electron-vite build && electron . --smoke-e2e",
    "smoke:agent": "electron-vite build && electron . --smoke-agent",
    "smoke:jev": "bun scripts/smoke-jev.ts",
    "smoke:map": "bun scripts/smoke-map.ts",
    "smoke:do": "electron-vite build && electron . --smoke-do",
    "smoke:window": "electron-vite build && electron . --smoke-window",
    "smoke:search": "electron-vite build && electron . --smoke-search",
    "smoke:ego": "electron-vite build && electron . --smoke-ego",
    "package:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "package:mac:arm64": "electron-vite build && electron-builder --mac --arm64"
  },
  "trustedDependencies": ["electron", "esbuild", "opencode-ai"],
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/sdk": "1.18.31",
    "ai": "7.0.107",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "solid-js": "^1.9.15",
    "xlsx": "0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "opencode-ai": "1.18.31",
    "typescript": "^7.0.2",
    "vite": "^7",
    "vite-plugin-solid": "^2.11.14"
  }
}
